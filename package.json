{
  "name": "cinderbelt",
  "private": true,
  "license": "MIT",
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:lang": "node tools/lint/lang.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:perf": "node tools/perf/build.mjs && playwright test -c playwright.perf.config.ts",
    "assets:optimize": "node art/tools/optimize_assets.mjs",
    "assets:check": "node art/tools/optimize_assets.mjs --check",
    "bot": "node tools/bot/run.mjs",
    "test:bot": "vitest run --config tools/bot/vitest.config.ts",
    "fixtures": "node tools/fixtures/run.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "preact": "^11.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/three": "^0.186.0",
    "fake-indexeddb": "^6.2.5",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
